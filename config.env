CONFIG_ENV=config.env

KERNEL_SOURCE=https://github.com/Nova-Kernels/kernel_xiaomi_mt6785
KERNEL_SOURCE_BRANCH=13.0
KERNEL_CONFIG=begonia_user_defconfig
ARCH=arm64
KERNEL_FILE=Image.gz-dtb
Clang version=clang18.0.0
EXTRA_BUILD_COMMAND:LD=ld.lld LLVM=1 LLVM_IAS=1
DISABLE-LTO=true
ENABLE_KERNELSU=true
APPLY_KSU_PATCH=false
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=false
DISABLE_CC_WERROR=true
